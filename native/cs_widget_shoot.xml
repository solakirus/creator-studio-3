<?xml version="1.0" encoding="utf-8"?>
<!-- The filming widget: what you are shooting, with the day count small above.
     Goes in: android/app/src/main/res/layout/cs_widget_shoot.xml

     The shoot line leads here, so it is the big text and the day is the label
     rather than the other way round. Same view ids as the others — the shared
     draw fills whichever exist. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/cs_widget_bg">

    <TextView
        android:id="@+id/w_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#7A736A"
        android:textSize="11sp"
        android:maxLines="1"
        android:text="Day 1" />

    <TextView
        android:id="@+id/w_shoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#EDE5D2"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="Nothing to film" />

    <TextView
        android:id="@+id/w_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B9B2A6"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <TextView
        android:id="@+id/w_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FB6900"
        android:textSize="12sp"
        android:maxLines="1"
        android:text="0/0 done" />

</LinearLayout>
